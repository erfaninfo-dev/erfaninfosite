{
  "name": "erfan-academy-web",
  "version": "0.1.0",
  "private": true,
  "description": "Erfan Academy on the web — a client of wordsapi. It owns no data.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "contract:check": "tsx scripts/contract-check.ts",
    "i18n:import": "tsx scripts/import-arb.ts",
    "e2e": "playwright test",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm contract:check",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@fontsource-variable/lexend": "^5.3.0",
    "@fontsource-variable/open-sans": "^5.3.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.24",
    "clsx": "^2.1.1",
    "intl-messageformat": "^12.1.4",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chrome-launcher": "^1.2.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.6",
    "lighthouse": "^13.6.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "unrs-resolver",
      "sharp"
    ]
  }
}
