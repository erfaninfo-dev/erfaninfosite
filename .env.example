# The PHP JSON API. The website is a client of this and owns no data.
WORDSAPI_BASE_URL=https://erfaninfo.com/wordsapi

# Public origin of this site. Used for canonical URLs, hreflang, sitemap, OG.
NEXT_PUBLIC_SITE_URL=https://erfaninfo.com

# Shared secret for POST /internal/revalidate. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=

# Guards the /status page. Visit /status?key=<this value>.
STATUS_SECRET=

# Phase 2 placeholder. Not used by the Phase 1 public site.
AUTH_COOKIE_NAME=erfan_session
